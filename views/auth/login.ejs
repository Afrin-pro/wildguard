<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-visual">
    <div class="auth-visual-content">
      <div class="auth-logo">🌿 WildGuard</div>
      <h2>Protecting wildlife<br>since day one.</h2>
      <div class="auth-animals">🦁 🐘 🦅 🐆 🌿</div>
    </div>
  </div>
  <div class="auth-form-side">
    <div class="auth-box">
      <h1>Welcome back</h1>
      <p class="auth-sub">Sign in to your WildGuard account</p>
      <form action="/auth/login" method="POST" class="auth-form">
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="you@example.com" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" placeholder="Your password" required>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Login</button>
      </form>
      <p class="auth-switch">Don't have an account? <a href="/auth/signup">Sign up free</a></p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
