<%- include('partials/header') %>

<div class="container notifications-page">
  <h1>🔔 Notifications</h1>

  <% if (notifications.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">🔔</div>
      <h3>All caught up!</h3>
      <p>No notifications yet. Register for events or report species to get started.</p>
    </div>
  <% } else { %>
    <% const icons = { event: '📅', species: '🦁', system: '🌿', admin: '⚙️' }; %>
    <% notifications.forEach(n => { %>
      <div class="notif-item <%= n.read ? '' : 'unread' %>">
        <span class="notif-icon"><%= icons[n.type] || '🔔' %></span>
        <div class="notif-content">
          <p>
            <%= n.message %>
            <% if (n.link) { %>
              <a href="<%= n.link %>">View →</a>
            <% } %>
          </p>
          <p class="notif-time"><%= n.createdAt.toDateString() %> · <%= n.createdAt.toTimeString().slice(0,5) %></p>
        </div>
        <% if (!n.read) { %>
          <span style="width:8px;height:8px;border-radius:50%;background:var(--green-accent);flex-shrink:0;margin-top:6px"></span>
        <% } %>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('partials/footer') %>
