<% if (user) { %>
<script>
  fetch('/notifications/count').then(r => r.json()).then(d => {
    if (d.count > 0) {
      const badge = document.getElementById('notifBadge');
      if (badge) { badge.textContent = d.count; badge.style.display = 'inline-flex'; }
    }
  });
</script>
<% } %>
