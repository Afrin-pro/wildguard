<%- include('../partials/header') %>

<div class="container form-page">
  <h1>Create Event</h1>
  <p class="form-sub">Schedule a new conservation event for the community.</p>

  <div class="form-card">
    <form action="/events/admin/create" method="POST">
      <div class="form-group">
        <label>Event Title *</label>
        <input type="text" name="title" placeholder="e.g. Forest Cleanup Drive" required>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Category *</label>
          <select name="category" required>
            <% ['Conservation','Cleanup','Research','Education','Fundraiser'].forEach(c => { %>
              <option value="<%= c %>"><%= c %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Date *</label>
          <input type="date" name="date" required>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Location *</label>
          <input type="text" name="location" placeholder="e.g. Sundarbans National Park" required>
        </div>
        <div class="form-group">
          <label>Capacity</label>
          <input type="number" name="capacity" value="50" min="1" max="10000">
        </div>
      </div>

      <div class="form-group">
        <label>Description *</label>
        <textarea name="description" rows="4" placeholder="Describe the event, what participants will do, what to bring..." required></textarea>
      </div>

      <div class="form-group">
        <label>Event Image URL <span class="optional">(optional)</span></label>
        <input type="url" name="image" placeholder="https://example.com/event-photo.jpg">
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create Event</button>
        <a href="/events" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
