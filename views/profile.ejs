<%- include('partials/header') %>

<div class="container profile-page">
  <div class="profile-header">
    <img src="<%= profileUser.avatar %>" alt="<%= profileUser.username %>" class="profile-avatar">
    <div class="profile-info">
      <h1><%= profileUser.username %></h1>
      <span class="role-badge role-<%= profileUser.role %>"><%= profileUser.role %></span>
      <p class="profile-bio"><%= profileUser.bio || 'No bio yet.' %></p>
      <p style="font-size:0.85rem;color:var(--text-muted);margin-top:6px">
        📧 <%= profileUser.email %> · Joined <%= profileUser.createdAt.toDateString() %>
      </p>
      <div style="margin-top:10px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <span style="background:var(--green-dark);color:white;padding:5px 14px;border-radius:20px;font-size:0.88rem;font-weight:600">
          🌿 <%= profileUser.conservationPoints || 0 %> pts
        </span>
        <% if (profileUser.badges && profileUser.badges.length > 0) { %>
          <div class="badges-wrap">
            <% profileUser.badges.forEach(b => { %>
              <span class="badge-pill" title="<%= b.name %>"><%= b.icon %> <%= b.name %></span>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="profile-grid">
    <div class="profile-section">
      <h2>Edit Profile</h2>
      <form action="/profile/update" method="POST" enctype="multipart/form-data">
        <div class="form-group" style="margin-bottom:1rem">
          <label>Profile Photo</label>
          <div class="avatar-preview-wrap">
            <img src="<%= profileUser.avatar %>" id="avatarPreview" class="avatar-preview">
            <input type="file" name="avatar" id="avatarInput" accept="image/*" onchange="previewAvatar(this)">
            <label for="avatarInput" class="avatar-btn">Change Photo</label>
          </div>
        </div>
        <div class="form-group" style="margin-bottom:1rem">
          <label>Username</label>
          <input type="text" name="username" value="<%= profileUser.username %>" required minlength="3">
        </div>
        <div class="form-group" style="margin-bottom:1.2rem">
          <label>Bio</label>
          <textarea name="bio" rows="3"><%= profileUser.bio || '' %></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </form>
    </div>

    <div class="profile-section">
      <h2>My Registered Events (<%= registeredEvents.length %>)</h2>
      <% if (registeredEvents.length === 0) { %>
        <div class="empty-state" style="padding:1.5rem 0">
          <p>You haven't registered for any events yet.</p>
          <a href="/events" class="btn btn-primary btn-sm" style="margin-top:0.8rem">Browse Events</a>
        </div>
      <% } else { %>
        <% registeredEvents.forEach(ev => { %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #f0f0f0">
            <div>
              <strong style="font-size:0.95rem"><%= ev.title %></strong>
              <p style="font-size:0.82rem;color:var(--text-muted)">📅 <%= ev.date.toDateString() %> · <%= ev.location %></p>
            </div>
            <a href="/events/<%= ev._id %>" class="btn btn-sm btn-outline">View</a>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<script>
function previewAvatar(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => document.getElementById('avatarPreview').src = e.target.result;
    reader.readAsDataURL(input.files[0]);
  }
}
</script>

<%- include('partials/footer') %>
